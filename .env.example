# ============================================================
# PPT Agent — 환경변수 설정 예시
# 이 파일을 복사해서 .env 로 저장하고 값을 채워주세요.
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# LLM (필수)
# ------------------------------------------------------------

# API 키 (필수) — LLM(research/design 공통) 기본 키. VLM_API_KEY 미설정 시 VLM에도 사용됨.
OPENAI_API_KEY=sk-...

# OpenAI 호환 커스텀 엔드포인트 (선택). 티어별 URL(MODEL_BIG_URL/MIDDLE_URL/SMALL_URL, VLM_MODEL_URL)이
# 미설정인 쪽의 공통 폴백값 — 그것도 없으면 기본값으로 SK hynix LiteLLM 게이트웨이를 사용.
# /research, /design-* 요청의 base_url 파라미터로 요청 단위로도 덮어쓸 수 있음.
# OPENAI_BASE_URL=http://workplace-litellm.aipp02.skhynix.com/v1

# LLM 요청 타임아웃 (초, 기본: 120)
# LLM_TIMEOUT=120

# ------------------------------------------------------------
# 모델 티어 (선택) — /research, /design-* 요청의 model_size 파라미터(big/middle/small)로 선택
# ------------------------------------------------------------

# big 티어 모델 (기본 모델이기도 함, research/design 에이전트 전용 — VLM과는 무관). 미설정 시 claude-opus-4-5로 폴백.
MODEL_BIG=claude-opus-4-5

# middle/small 티어 모델. 미설정 상태로 요청에서 선택하면 400 에러.
# MODEL_MIDDLE=claude-sonnet-5
# MODEL_SMALL=claude-haiku-4-5

# 티어별 전용 엔드포인트 (선택) — 티어마다 실제 서빙되는 서버가 다를 때 사용. 미설정인 티어는
# OPENAI_BASE_URL → 기본값(SK hynix 게이트웨이) 순으로 폴백.
# MODEL_BIG_URL=http://big-model-gateway.example.com/v1
# MODEL_MIDDLE_URL=http://middle-model-gateway.example.com/v1
# MODEL_SMALL_URL=http://small-model-gateway.example.com/v1

# big 티어 전용 API 키 (선택, 미설정 시 OPENAI_API_KEY 사용). middle/small은 항상 OPENAI_API_KEY 사용.
# OPENAI_API_KEY_BIG=sk-...

# 티어(big/middle/small) 대신 요청에서 직접 모델을 지정하고 싶을 때 — model_name 파라미터를
# base_url 파라미터와 함께 보내면, model_size로 고른 티어가 .env에 설정돼 있지 않아도 그
# model_name + base_url 조합으로 즉석 LLM을 만들어 사용함 (그때도 model_size는 API 키 선택에는
# 여전히 쓰임: big이면 OPENAI_API_KEY_BIG 우선, 아니면 OPENAI_API_KEY).

# ------------------------------------------------------------
# 출력 언어 (선택)
# ------------------------------------------------------------

# PPT 생성 언어: en (영어, 기본값) 또는 ko (한국어)
# 설정 시 모든 요청의 language 파라미터를 이 값으로 덮어씀.
# PPT_LANGUAGE=en

# ------------------------------------------------------------
# Heavy-Reflect — VLM 시각 검토 (선택)
# ------------------------------------------------------------
# inspect_slide가 구조/overflow 검증을 통과한 슬라이드 스크린샷을, Design 에이전트의 텍스트
# 생성 모델(MODEL_BIG/MIDDLE/SMALL)과는 완전히 별도로, VLM_MODEL_NAME 모델에 단독 요청으로
# 보내 겹침(overlap) 여부만 시각적으로 검토받는다. Design 에이전트 자신은 이미지를 보지 않고,
# VLM이 돌려준 텍스트 리뷰만 받는다.

# 활성화 시 1 로 설정 (VLM_MODEL_NAME 도 함께 설정 필요)
# HEAVY_REFLECT=1

# Heavy-reflect 전용 멀티모달(vision) 모델 — MODEL_BIG/MIDDLE/SMALL과 별개
# VLM_MODEL_NAME=claude-opus-4-5

# VLM 전용 엔드포인트 (선택). 미설정 시 OPENAI_BASE_URL → 기본값(SK hynix 게이트웨이) 순으로 폴백.
# VLM_MODEL_URL=http://vlm-model-gateway.example.com/v1

# VLM 전용 API 키 (선택, 미설정 시 OPENAI_API_KEY 사용)
# VLM_API_KEY=sk-...

# ------------------------------------------------------------
# Design 에이전트 커스텀 설정 (선택)
# ------------------------------------------------------------

# 커스텀 role YAML 파일 경로 (.yaml/.yml)
# DESIGN_CONFIG_FILE=/path/to/design-hynix.yaml

# 커스텀 디자인 가이드 파일 경로 (.md)
# DESIGN_TEMPLATE_FILE=/path/to/design-guide.md

# ------------------------------------------------------------
# 서버 설정 (선택)
# ------------------------------------------------------------

# 바인드 호스트 (기본: 0.0.0.0)
# HOST=0.0.0.0

# 바인드 포트 (기본: 5000)
# PORT=5000

# 코드 변경 시 자동 재시작 — 운영 환경에서는 false (기본: true)
# RELOAD=true

# 로그 레벨: debug / info / warning / error / critical (기본: info)
# LOG_LEVEL=info

# ------------------------------------------------------------
# Playwright / Chromium (선택)
# ------------------------------------------------------------

# Chromium 실행 파일 경로 (시스템 PATH에 없는 경우)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chrome

# ------------------------------------------------------------
# 에이전트 동작 세부 조정 (선택)
# ------------------------------------------------------------

# 워크스페이스 루트 디렉터리 (기본: deeppresenter/output/YYYYMMDD). 콘솔에 찍히는 로그가
# 그대로 이 디렉터리의 server.log 파일에도 이어쓰기(append)로 남는다.
# DEEPPRESENTER_WORKSPACE_BASE=/path/to/workspace

# 로깅 레벨 숫자값 (기본: 20 = INFO)
# DEEPPRESENTER_LOG_LEVEL=20

# 도구 출력 최대 길이 (기본: 4096)
# TOOL_CUTOFF_LEN=4096

# 컨텍스트 길이 제한 (기본: 200000)
# CONTEXT_LENGTH_LIMIT=200000

# 재시도 횟수 (기본: 3)
# RETRY_TIMES=3

# VLM에 전달하는 최대 이미지 수 (기본: 2)
# VLM_MAX_IMAGES=2

# 슬라이드 스크린샷(screenshot_slide) 렌더링 실패 시 최대 시도 횟수, 1이면 재시도 없음 (기본: 5).
# 동시 Chromium 실행이 많을수록(DESIGN_PARALLEL_CONCURRENCY를 높게 잡을 때 등) 자원 경합으로
# 인한 실패가 잦아질 수 있어 상한을 둔다 — 절대 무제한으로 두지 말 것.
# SCREENSHOT_MAX_RETRIES=5

# ------------------------------------------------------------
# Research 속도 개선 (선택)
# ------------------------------------------------------------

# inspect_content(원고 내용 품질 LLM 리뷰) 활성화 여부. 기본 꺼짐 — 결과물 기대치 대비 호출
# 시간이 오래 걸려서 기본적으로 Research의 toolset에서 아예 제외한다. 켜면 다시 사용 가능.
# HEAVY_CONTENT_REVIEW=1

# inspect_content가 한 번의 실행(run)에서 최대 몇 번까지 호출될 수 있는지 (기본: 2)
# INSPECT_CONTENT_MAX_CALLS=2

# ------------------------------------------------------------
# Design 병렬화 — template-based(hynix) 경로 전용 (선택)
# ------------------------------------------------------------
# 슬라이드를 한 장씩 순차 생성하는 대신, 원고를 여러 청크로 나눠 워커별로 asyncio.Semaphore로
# 동시 처리한다 (design_graph.py의 run_design_graph_parallel). template-free 경로는 항상 기존
# 직렬 방식 그대로 동작한다 (이 플래그의 영향을 받지 않음).

# 활성화 시 1로 설정 (기본 꺼짐 — 기존 직렬 run_design_graph 그대로 동작)
# DESIGN_PARALLEL_MODE=1

# 콘텐츠 워커 1개가 담당하는 원고 페이지 수 (기본: 3)
# DESIGN_PARALLEL_CHUNK_SIZE=3

# 동시에 실행할 최대 워커 수 (기본: 4)
# DESIGN_PARALLEL_CONCURRENCY=4

# ------------------------------------------------------------
# MinIO — 생성된 PPTX 저장소 (필수)
# ------------------------------------------------------------
# /template-based-ppt-generation, /template-free-ppt-generation(-db)이 생성한 산출물을
# "{emp_no}/slide/{artifact_id}/{ppt,htmls,combined_html}/..." 경로로 업로드.
# secure(TLS)는 항상 false로 고정 사용.

# 업로드 대상 버킷 이름
MINIO_FILE_BUCKET=ppt-agent

# MinIO 엔드포인트 (host:port, 스킴 없이)
MINIO_ENDPOINT=localhost:9000

# MinIO 접근 키
MINIO_ACCESS_KEY=minioadmin

# MinIO 시크릿 키
MINIO_SECRET_KEY=minioadmin

# ------------------------------------------------------------
# PostgreSQL — sources 테이블 조회 (필수, /template-*-ppt-generation-db 용)
# ------------------------------------------------------------
# /template-based-ppt-generation-db, /template-free-ppt-generation-db 가 요청받은
# id 목록으로 sources 테이블에서 raw_text를 조회할 때 사용.

DB_HOST=localhost

# 포트 (기본: 5432)
# DB_PORT=5432

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------
# Langfuse — LLM 관측성/트레이싱 (선택, 셀프호스팅)
# ------------------------------------------------------------
# 새 LangGraph 기반 엔진(deeppresenter/graph/)에서만 사용됨. 셋 다 설정해야 활성화되고,
# 하나라도 비어 있으면 트레이싱 없이 그냥 동작함 (design-hynix/free-template pilot).
# LANGFUSE_HOST 는 실제 셀프호스팅 인스턴스 URL로 채워야 함 — 아래 값은 예시일 뿐 실제 주소 아님.
# LANGFUSE_HOST=https://your-langfuse-host.example.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
